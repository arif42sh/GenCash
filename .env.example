# ==============================================================================
# GenCash Enterprise Environment Configuration Template (.env.example)
# ==============================================================================
# Security Policy:
# 1. NEVER commit your actual .env file to public version control.
# 2. SECRET_KEY MUST be a cryptographically strong 256-bit random hex/base64 string.
#    Generate one via: python -c "import secrets; print(secrets.token_hex(32))"
# 3. Weak passwords or default placeholders will trigger zero-fallback startup crash.
# ==============================================================================

# Core Project Settings
PROJECT_NAME="GenCash"
VERSION="1.0.0"
ENVIRONMENT="production"
API_V1_STR="/api"

# Cryptographic Authentication Secret (MANDATORY: Minimum 32 characters, no placeholders)
SECRET_KEY="your_production_256bit_jwt_secret_key_minimum_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Configuration
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="gencash_prod_user"
DB_PASSWORD="your_strong_database_password_here"
DB_NAME="gencash_db"

# SQLite Auto-Fallback (Set to false in dedicated clustered database environments)
USE_SQLITE_FALLBACK=true

# Rate Limiting Configuration
RATE_LIMIT_AUTH_PER_MINUTE="5/minute"
RATE_LIMIT_API_PER_MINUTE="60/minute"

# Financial Business Rules
DEMO_INITIAL_WALLET_BALANCE=5000.00
DEFAULT_CURRENCY="BDT"
DEFAULT_FEE_SEND_MONEY=5.00
DEFAULT_FEE_CASH_OUT_PERCENT=1.85
